# .env.example — Estructura de variables de entorno (sin valores reales)
# Copia este archivo a .env.local y completa los valores.
# NUNCA comites .env.local ni expongas claves secretas en el cliente.

# ─── NextAuth (v4) ────────────────────────────────────────────────────────────
# Secreto para firmar las tokens JWT de la sesión. Generar uno robusto, p. ej.:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# URL pública de la aplicación (sin barra final). En local: http://localhost:3000
# En producción: https://tu-dominio.com
NEXTAUTH_URL=

# ─── URL canónica para callbacks OAuth (redes sociales) ───────────────────────
# Usada por el flujo de verificación de redes (OAuth directo → /api/auth/callback/*).
# En local: http://localhost:3000 · En producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=

# ─── Discord OAuth (proveedor de NextAuth) ────────────────────────────────────
# Desde https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── OAuth de redes sociales (verificación oficial) ───────────────────────────
# Callback a registrar en cada portal: https://tu-dominio.com/api/auth/callback/<plataforma>
# Twitch: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# X (Twitter): https://developer.x.com → Proyecto con OAuth 2.0 (Web App / PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Google (YouTube): https://console.cloud.google.com/apis/credentials
# Requiere habilitar YouTube Data API v3 y el scope youtube.readonly en el consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Desde https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon). Segura para el cliente: respeta RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (service_role). SOLO servidor — ignora RLS.
# No usar con prefijo NEXT_PUBLIC ni importarla en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=
